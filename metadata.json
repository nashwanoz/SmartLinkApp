import React, { useState } from 'react';
import {
  Package,
  Plus,
  Search,
  Edit2,
  Trash2,
  X,
  Check,
  AlertCircle,
  LayoutGrid,
  ChevronLeft,
  List,
  Sparkles,
  Layers,
  Box,
  ShoppingCart,
  ArrowRight,
} from 'lucide-react';
import { Product, SystemSettings, User } from '../types';
import { formatCurrency } from '../utils/whatsappTemplates';

interface ProductsScreenProps {
  products: Product[];
  currentUser: User;
  users?: User[];
  settings: SystemSettings;
  onSaveProduct: (product: Partial<Product>, isEdit: boolean) => void;
  onDeleteProduct: (productId: number) => void;
  onSelectForPos?: (product: Product) => void;
  onNavigateToTransfer?: (productId?: number) => void;
}

type ViewMode = 'grid' | 'strip' | 'table';

export const ProductsScreen: React.FC<ProductsScreenProps> = ({
  products,
  currentUser,
  settings,
  onSaveProduct,
  onDeleteProduct,
  onSelectForPos,
}) => {
  const [viewMode, setViewMode] = useState<ViewMode>('grid');
  const [searchTerm, setSearchTerm] = useState('');
  const [isModalOpen, setIsModalOpen] = useState(false);
  const [editingProduct, setEditingProduct] = useState<Product | null>(null);
  const [quickNotice, setQuickNotice] = useState<string | null>(null);

  // Form States for Adding / Editing Product
  const [formBarcode, setFormBarcode] = useState('');
  const [formName, setFormName] = useState('');

  // 1. الوحدة الرئيسية (معلوم أنها 1 دائماً بدون مربع إدخال عدد)
  const [formCaseUnitName, setFormCaseUnitName] = useState('كرت');
  const [formCasePrice, setFormCasePrice] = useState('');

  // 2. الوحدة الفرعية (نحدد اسم الوحدة وكميتها وسعرها)
  const [formUnitName, setFormUnitName] = useState('صفحه');
  const [formCaseQuantity, setFormCaseQuantity] = useState('24');
  const [formPrice, setFormPrice] = useState('');

  // كمية المخزون الإجمالية للصنف
  const [formStockMain, setFormStockMain] = useState('100');
  const [errorMsg, setErrorMsg] = useState('');

  const isAdmin = currentUser.role === 'ADMIN';

  const showToast = (msg: string) => {
    setQuickNotice(msg);
    setTimeout(() => setQuickNotice(null), 2500);
  };

  // Open Modal for adding new product
  const openAddModal = () => {
    setEditingProduct(null);
    setFormBarcode(`6281000${String(products.length + 1).padStart(3, '0')}`);
    setFormName('');
    setFormCaseUnitName('كرت');
    setFormCasePrice('');
    setFormUnitName('صفحه');
    setFormCaseQuantity('24');
    setFormPrice('');
    setFormStockMain('100');
    setErrorMsg('');
    setIsModalOpen(true);
  };

  // Open Modal for editing product or when clicking product card
  const openEditModal = (p: Product) => {
    setEditingProduct(p);
    setFormBarcode(p.barcode || String(p.id));
    setFormName(p.name);
    setFormCaseUnitName(p.caseUnitName || 'كرت');
    setFormCasePrice(String(p.casePrice || ''));
    setFormUnitName(p.unitName || 'صفحه');
    setFormCaseQuantity(String(p.caseQuantity || 1));
    setFormPrice(String(p.price || ''));
    setFormStockMain(String(p.stockMain || 0));
    setErrorMsg('');
    setIsModalOpen(true);
  };

  // Handle Form Submit
  const handleSubmit = (e: React.FormEvent) => {
    e.preventDefault();
    setErrorMsg('');

    const trimmedName = formName.trim();
    if (!trimmedName) {
      setErrorMsg('يرجى إدخال اسم الصنف');
      return;
    }

    const trimmedCaseUnit = formCaseUnitName.trim();
    if (!trimmedCaseUnit) {
      setErrorMsg('يرجى إدخال اسم الوحدة الرئيسية');
      return;
    }

    const trimmedSubUnit = formUnitName.trim();
    if (!trimmedSubUnit) {
      setErrorMsg('يرجى إدخال اسم الوحدة الفرعية');
      return;
    }

    const subPriceNum = parseFloat(formPrice);
    if (isNaN(subPriceNum) || subPriceNum < 0) {
      setErrorMsg('يرجى إدخال سعر صحيح للوحدة الفرعية');
      return;
    }

    const subQtyPerMain = parseInt(formCaseQuantity, 10) || 1;
    if (subQtyPerMain < 1) {
      setErrorMsg('يرجى إدخال كمية صحيحة للوحدة الفرعية');
      return;
    }

    const mainPriceNum =
      formCasePrice !== '' ? parseFloat(formCasePrice) || 0 : subPriceNum * subQtyPerMain;
    const stockNum = parseFloat(formStockMain) || 0;

    onSaveProduct(
      {
        id: editingProduct ? editingProduct.id : Date.now(),
        barcode: formBarcode.trim() || `6281000${String(Date.now()).slice(-4)}`,
        name: trimmedName,
        caseUnitName: trimmedCaseUnit,
        caseQuantity: subQtyPerMain,
        casePrice: mainPriceNum,
        unitName: trimmedSubUnit,
        price: subPriceNum,
        stockMain: stockNum,
        stockCashier: editingProduct ? editingProduct.stockCashier : {},
      },
      !!editingProduct
    );

    setIsModalOpen(false);
  };

  // Handle Quick POS selection
  const handleQuickAdd = (p: Product, unitType: 'main' | 'sub', e: React.MouseEvent) => {
    e.stopPropagation();
    if (onSelectForPos) {
      onSelectForPos(p);
      showToast(`تم تحويل الصنف (${p.name}) لنقطة البيع`);
    } else {
      openEditModal(p);
    }
  };

  // Filter products based on search
  const filteredProducts = products.filter((p) => {
    const s = searchTerm.toLowerCase().trim();
    if (!s) return true;
    return (
      (p.barcode && p.barcode.toLowerCase().includes(s)) ||
      p.name.toLowerCase().includes(s) ||
      (p.caseUnitName && p.caseUnitName.toLowerCase().includes(s)) ||
      (p.unitName && p.unitName.toLowerCase().includes(s))
    );
  });

  return (
    <div className="space-y-3.5 text-right font-sans">
      {/* Toast notification */}
      {quickNotice && (
        <div className="fixed bottom-6 left-1/2 -translate-x-1/2 z-50 bg-slate-900/95 text-white px-4 py-2 rounded-2xl text-xs font-bold shadow-2xl flex items-center gap-2 animate-in fade-in">
          <Check className="w-4 h-4 text-emerald-400" />
          <span>{quickNotice}</span>
        </div>
      )}

      {/* Top Controls Bar: View Mode Switcher + Add Button */}
      <div className="flex items-center justify-between flex-wrap gap-2.5">
        {/* View Switcher: شبكة / شريط / قائمة (محاكاة الصورة المرفقة بدقة) */}
        <div className="flex items-center bg-slate-100/90 p-1 rounded-2xl border border-slate-200/80 gap-1">
          {/* شبكة (Grid) */}
          <button
            type="button"
            onClick={() => setViewMode('grid')}
            className={`flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl text-xs font-black transition cursor-pointer ${
              viewMode === 'grid'
                ? 'bg-white text-slate-900 shadow-xs border border-slate-200/60'
                : 'text-slate-500 hover:text-slate-800'
            }`}
          >
            <LayoutGrid className="w-3.5 h-3.5" />
            <span>شبكة</span>
          </button>

          {/* شريط (Strip) */}
          <button
            type="button"
            onClick={() => setViewMode('strip')}
            className={`flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl text-xs font-black transition cursor-pointer ${
              viewMode === 'strip'
                ? 'bg-white text-slate-900 shadow-xs border border-slate-200/60'
                : 'text-slate-500 hover:text-slate-800'
            }`}
          >
            <ChevronLeft className="w-3.5 h-3.5" />
            <span>شريط</span>
          </button>

          {/* قائمة (List / Table) */}
          <button
            type="button"
            onClick={() => setViewMode('table')}
            className={`flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl text-xs font-black transition cursor-pointer ${
              viewMode === 'table'
                ? 'bg-white text-slate-900 shadow-xs border border-slate-200/60'
                : 'text-slate-500 hover:text-slate-800'
            }`}
          >
            <List className="w-3.5 h-3.5" />
            <span>قائمة</span>
          </button>
        </div>

        {/* Add Product Button */}
        <button
          type="button"
          onClick={openAddModal}
          className="bg-emerald-600 hover:bg-emerald-700 active:scale-98 text-white px-3.5 py-2 rounded-xl text-xs font-black flex items-center gap-1.5 shadow-xs transition cursor-pointer"
        >
          <Plus className="w-4 h-4" />
          <span>اضافه صنف</span>
        </button>
      </div>

      {/* Search Input Bar (مطابق للنمط بالصورة) */}
      <div className="relative">
        <input
          type="text"
          value={searchTerm}
          onChange={(e) => setSearchTerm(e.target.value)}
          placeholder="🔍 ابحث بالاسم أو الباركود لعرض وتصفية الأصناف فوراً..."
          className="w-full bg-white border border-slate-300/90 rounded-2xl px-4 py-2.5 text-xs font-bold text-slate-800 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-[#005953] pl-9 shadow-2xs"
        />
        {searchTerm && (
          <button
            type="button"
            onClick={() => setSearchTerm('')}
            className="absolute left-3 top-3 text-slate-400 hover:text-slate-600 cursor-pointer"
          >
            <X className="w-4 h-4" />
          </button>
        )}
      </div>

      {/* Total Count (إجمالي الأصناف: 4) */}
      <div className="text-xs font-black text-emerald-800 flex items-center gap-1.5 px-1">
        <span>إجمالي الأصناف:</span>
        <span className="font-mono text-sm">{filteredProducts.length}</span>
      </div>

      {/* VIEW 1: GRID MODE (شبكة) - مربعات صغيرة تحتوي اسم الصنف فقط مع زر التعديل */}
      {viewMode === 'grid' && (
        <>
          {filteredProducts.length === 0 ? (
            <div className="bg-white rounded-2xl border border-slate-200 p-10 text-center text-slate-400 text-xs font-medium space-y-2">
              <Package className="w-9 h-9 mx-auto text-slate-300" />
              <div>لا توجد أصناف مطابقة للبحث</div>
            </div>
          ) : (
            <div className="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-2.5">
              {filteredProducts.map((p) => {
                return (
                  <div
                    key={p.id}
                    onClick={() => openEditModal(p)}
                    className="relative bg-white hover:bg-slate-50/80 border border-slate-200/90 hover:border-[#0F766E]/50 rounded-2xl p-3.5 shadow-2xs hover:shadow-xs transition cursor-pointer flex flex-col items-center justify-center text-center aspect-square group"
                  >
                    {/* Edit Button in corner */}
                    <button
                      type="button"
                      onClick={(e) => {
                        e.stopPropagation();
                        openEditModal(p);
                      }}
                      className="absolute top-2.5 left-2.5 w-7 h-7 rounded-xl bg-slate-100/80 hover:bg-teal-50 text-slate-500 hover:text-[#0F766E] flex items-center justify-center transition cursor-pointer"
                      title="تعديل الصنف"
                    >
                      <Edit2 className="w-3.5 h-3.5" />
                    </button>

                    {/* Product Name Only */}
                    <h3 className="font-black text-xs sm:text-sm text-slate-800 group-hover:text-[#0F766E] transition leading-snug line-clamp-3 px-1">
                      {p.name}
                    </h3>
                  </div>
                );
              })}
            </div>
          )}
        </>
      )}

      {/* VIEW 2: STRIP MODE (شريط) - عرض أفقي رسمي وأنيق */}
      {viewMode === 'strip' && (
        <div className="space-y-2">
          {filteredProducts.length === 0 ? (
            <div className="bg-white rounded-2xl border border-slate-200 p-8 text-center text-slate-400 text-xs font-medium">
              لا توجد أصناف مطابقة للبحث
            </div>
          ) : (
            filteredProducts.map((p) => {
              const mainUnit = p.caseUnitName || 'كرت';
              const totalStock = p.stockMain || 0;

              return (
                <div
                  key={p.id}
                  onClick={() => openEditModal(p)}
                  className="bg-white hover:bg-slate-50/80 border border-slate-200/90 hover:border-[#0F766E]/50 rounded-2xl p-3 shadow-2xs hover:shadow-xs transition cursor-pointer flex items-center justify-between gap-3"
                >
                  {/* Product Name */}
                  <div className="flex-1 min-w-0">
                    <h3 className="font-black text-xs sm:text-sm text-slate-800 truncate">
                      {p.name}
                    </h3>
                  </div>

                  {/* Available Quantity + Edit Button */}
                  <div className="flex items-center gap-2.5 shrink-0">
                    <div className="bg-emerald-50/70 border border-emerald-100/90 text-emerald-900 px-3 py-1.5 rounded-xl text-xs font-bold flex items-center gap-1.5">
                      <span className="text-[10px] text-emerald-700">المتوفر:</span>
                      <span className="font-mono font-black">{totalStock}</span>
                      <span className="text-[10px] text-emerald-700">{mainUnit}</span>
                    </div>

                    <button
                      type="button"
                      onClick={(e) => {
                        e.stopPropagation();
                        openEditModal(p);
                      }}
                      className="w-8 h-8 rounded-xl bg-slate-100 hover:bg-teal-50 text-slate-600 hover:text-[#0F766E] flex items-center justify-center transition cursor-pointer"
                      title="تعديل الصنف"
                    >
                      <Edit2 className="w-3.5 h-3.5" />
                    </button>
                  </div>
                </div>
              );
            })
          )}
        </div>
      )}

      {/* VIEW 3: TABLE MODE (قائمة) */}
      {viewMode === 'table' && (
        <div className="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-2xs">
          <div className="overflow-x-auto">
            <table className="w-full text-right text-xs">
              <thead className="bg-slate-50 text-slate-600 font-bold border-b border-slate-200">
                <tr>
                  <th className="p-3">اسم الصنف</th>
                  <th className="p-3 text-center">الكمية المتوفرة</th>
                  <th className="p-3 text-center w-20">تعديل</th>
                </tr>
              </thead>
              <tbody className="divide-y divide-slate-100 font-bold text-slate-800">
                {filteredProducts.length === 0 ? (
                  <tr>
                    <td colSpan={3} className="p-8 text-center text-slate-400 font-normal">
                      لا توجد أصناف مطابقة للبحث
                    </td>
                  </tr>
                ) : (
                  filteredProducts.map((p) => {
                    const mainUnit = p.caseUnitName || 'كرت';
                    const totalStock = p.stockMain || 0;

                    return (
                      <tr
                        key={p.id}
                        onClick={() => openEditModal(p)}
                        className="hover:bg-slate-50/80 transition cursor-pointer"
                      >
                        <td className="p-3 font-black text-slate-800 text-xs">
                          {p.name}
                        </td>
                        <td className="p-3 text-center font-mono font-black text-xs text-emerald-800">
                          {totalStock}{' '}
                          <span className="text-[10px] font-normal text-slate-500">{mainUnit}</span>
                        </td>
                        <td className="p-3 text-center" onClick={(e) => e.stopPropagation()}>
                          <div className="flex items-center justify-center">
                            <button
                              type="button"
                              onClick={() => openEditModal(p)}
                              className="p-1.5 text-teal-700 bg-teal-50 hover:bg-teal-100 rounded-lg transition cursor-pointer"
                              title="تعديل الصنف"
                            >
                              <Edit2 className="w-3.5 h-3.5" />
                            </button>
                          </div>
                        </td>
                      </tr>
                    );
                  })
                )}
              </tbody>
            </table>
          </div>
        </div>
      )}

      {/* MODAL: ADD / EDIT PRODUCT */}
      {isModalOpen && (
        <div className="fixed inset-0 z-50 bg-slate-950/70 backdrop-blur-xs flex items-center justify-center p-3 sm:p-4 text-right animate-in fade-in duration-150">
          <div className="bg-white rounded-3xl w-full max-w-lg shadow-2xl border border-slate-200 overflow-hidden flex flex-col max-h-[92vh]">
            {/* Modal Header */}
            <div className="bg-gradient-to-r from-emerald-800 via-teal-800 to-[#0F766E] text-white px-4 py-3 flex items-center justify-between">
              <div className="flex items-center gap-2">
                <div className="w-8 h-8 rounded-xl bg-white/10 flex items-center justify-center text-emerald-300">
                  <Package className="w-4 h-4" />
                </div>
                <div>
                  <h3 className="font-extrabold text-xs sm:text-sm">
                    {editingProduct ? 'تعديل بيانات الصنف' : 'إضافة صنف جديد'}
                  </h3>
                  <p className="text-[10px] text-teal-100/90 font-mono">جدول الأصناف (ias_itm)</p>
                </div>
              </div>

              <button
                type="button"
                onClick={() => setIsModalOpen(false)}
                className="w-7 h-7 rounded-xl bg-white/10 hover:bg-white/20 text-white flex items-center justify-center transition cursor-pointer"
              >
                <X className="w-4 h-4" />
              </button>
            </div>

            {/* Modal Form */}
            <form onSubmit={handleSubmit} className="flex-1 overflow-y-auto p-4 space-y-3.5 text-xs">
              {errorMsg && (
                <div className="bg-rose-50 border border-rose-200 text-rose-800 rounded-xl p-2.5 flex items-center gap-2 font-bold">
                  <AlertCircle className="w-4 h-4 text-rose-600 shrink-0" />
                  <span>{errorMsg}</span>
                </div>
              )}

              {/* Main Fields: i_code and i_name */}
              <div className="bg-slate-50 border border-slate-200 rounded-2xl p-3 space-y-2.5">
                <div className="grid grid-cols-1 sm:grid-cols-3 gap-2.5">
                  {/* i_code */}
                  <div className="sm:col-span-1">
                    <label className="block text-[11px] font-bold text-slate-700 mb-1">
                      رقم الصنف (i_code) *
                    </label>
                    <input
                      type="text"
                      required
                      value={formBarcode}
                      onChange={(e) => setFormBarcode(e.target.value.trim())}
                      placeholder="62810001"
                      className="w-full bg-white border border-slate-300 rounded-xl px-2.5 py-1.5 text-xs font-mono font-bold text-slate-900 focus:outline-none focus:ring-1 focus:ring-emerald-600 text-left"
                      dir="ltr"
                    />
                  </div>

                  {/* i_name */}
                  <div className="sm:col-span-2">
                    <label className="block text-[11px] font-bold text-slate-700 mb-1">
                      اسم الصنف (i_name) *
                    </label>
                    <input
                      type="text"
                      required
                      value={formName}
                      onChange={(e) => setFormName(e.target.value)}
                      placeholder="مثال: كروت ابو 100"
                      className="w-full bg-white border border-slate-300 rounded-xl px-3 py-1.5 text-xs font-bold text-slate-900 focus:outline-none focus:ring-1 focus:ring-emerald-600"
                    />
                  </div>
                </div>
              </div>

              {/* Unit 1: الوحدة الرئيسية (الأولى إجباري - معلوم أنها 1 دائماً بدون مربع إدخال عدد) */}
              <div className="bg-emerald-50/60 border border-emerald-200 rounded-2xl p-3 space-y-2.5">
                <div className="flex items-center justify-between border-b border-emerald-200/80 pb-1 text-emerald-950 font-black text-xs">
                  <span className="flex items-center gap-1.5">
                    <span className="w-5 h-5 rounded-full bg-emerald-600 text-white flex items-center justify-center text-[10px] font-mono">
                      1
                    </span>
                    <span>الوحدة الرئيسية (الأولى - إجباري)</span>
                  </span>
                  <span className="text-[10px] text-emerald-800 font-bold bg-emerald-100/80 px-2 py-0.5 rounded-md">
                    العدد: 1 دائماً
                  </span>
                </div>

                <div className="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                  <div>
                    <label className="block text-[10px] font-bold text-emerald-900 mb-1">
                      اسم الوحدة الرئيسية (i_size) *
                    </label>
                    <input
                      type="text"
                      required
                      value={formCaseUnitName}
                      onChange={(e) => setFormCaseUnitName(e.target.value)}
                      placeholder="مثال: كرت / كرتون / باكت"
                      className="w-full bg-white border border-emerald-300 rounded-xl px-2.5 py-1.5 text-xs font-bold text-slate-900 focus:outline-none focus:ring-1 focus:ring-emerald-600"
                    />
                  </div>

                  <div>
                    <label className="block text-[10px] font-bold text-emerald-900 mb-1">
                      سعر الوحدة الرئيسية (i_price)
                    </label>
                    <input
                      type="number"
                      step="0.01"
                      min="0"
                      value={formCasePrice}
                      onChange={(e) => setFormCasePrice(e.target.value)}
                      placeholder="سعر بيع الوحدة الرئيسية"
                      className="w-full bg-white border border-emerald-300 rounded-xl px-2.5 py-1.5 text-xs font-mono font-bold text-center text-[#0F766E] focus:outline-none focus:ring-1 focus:ring-emerald-600"
                    />
                  </div>
                </div>
              </div>

              {/* Unit 2: الوحدة الفرعية (نحدد اسم الوحدة وكمية الوحدة وسعر الوحدة) */}
              <div className="bg-slate-50 border border-slate-200 rounded-2xl p-3 space-y-2.5">
                <div className="flex items-center justify-between border-b border-slate-200 pb-1 text-slate-800 font-black text-xs">
                  <span className="flex items-center gap-1.5">
                    <span className="w-5 h-5 rounded-full bg-slate-500 text-white flex items-center justify-center text-[10px] font-mono">
                      2
                    </span>
                    <span>الوحدة الفرعية (الثانية)</span>
                  </span>
                  <span className="text-[10px] text-slate-500 font-bold">معامل التحويل والسعر</span>
                </div>

                <div className="grid grid-cols-1 sm:grid-cols-3 gap-2">
                  <div>
                    <label className="block text-[10px] font-bold text-slate-700 mb-1">
                      اسم الوحدة الفرعية *
                    </label>
                    <input
                      type="text"
                      required
                      value={formUnitName}
                      onChange={(e) => setFormUnitName(e.target.value)}
                      placeholder="صفحه / حبة"
                      className="w-full bg-white border border-slate-300 rounded-xl px-2.5 py-1.5 text-xs font-bold text-slate-900 focus:outline-none focus:ring-1 focus:ring-emerald-600"
                    />
                  </div>

                  <div>
                    <label className="block text-[10px] font-bold text-slate-700 mb-1">
                      الكمية داخل الرئيسية *
                    </label>
                    <input
                      type="number"
                      min="1"
                      required
                      value={formCaseQuantity}
                      onChange={(e) => setFormCaseQuantity(e.target.value)}
                      placeholder="مثال: 24"
                      className="w-full bg-white border border-slate-300 rounded-xl px-2.5 py-1.5 text-xs font-mono font-bold text-center text-slate-900 focus:outline-none focus:ring-1 focus:ring-emerald-600"
                    />
                  </div>

                  <div>
                    <label className="block text-[10px] font-bold text-slate-700 mb-1">
                      سعر الوحدة الفرعية *
                    </label>
                    <input
                      type="number"
                      step="0.01"
                      min="0"
                      required
                      value={formPrice}
                      onChange={(e) => setFormPrice(e.target.value)}
                      placeholder="سعر الوحدة الفرعية"
                      className="w-full bg-white border border-slate-300 rounded-xl px-2.5 py-1.5 text-xs font-mono font-bold text-center text-[#0F766E] focus:outline-none focus:ring-1 focus:ring-emerald-600"
                    />
                  </div>
                </div>
              </div>

              {/* Stock Quantity */}
              <div className="bg-slate-50 border border-slate-200 rounded-2xl p-3">
                <label className="block text-[11px] font-bold text-slate-700 mb-1">
                  كمية المخزون الإجمالية المتاحة *
                </label>
                <div className="flex items-center gap-2">
                  <input
                    type="number"
                    min="0"
                    step="1"
                    required
                    value={formStockMain}
                    onChange={(e) => setFormStockMain(e.target.value)}
                    className="w-full bg-white border border-slate-300 rounded-xl px-3 py-1.5 text-xs font-mono font-bold text-slate-900 focus:outline-none focus:ring-1 focus:ring-emerald-600 text-center"
                  />
                  <span className="text-slate-600 font-bold text-xs whitespace-nowrap">
                    {formCaseUnitName || 'كرت'}
                  </span>
                </div>
              </div>

              {/* Modal Buttons */}
              <div className="pt-2 flex items-center justify-between gap-2 border-t border-slate-100">
                {editingProduct && isAdmin ? (
                  <button
                    type="button"
                    onClick={() => {
                      if (window.confirm(`هل أنت متأكد من حذف الصنف (${editingProduct.name})؟`)) {
                        onDeleteProduct(editingProduct.id);
                        setIsModalOpen(false);
                      }
                    }}
                    className="px-3 py-2 bg-rose-50 hover:bg-rose-100 text-rose-700 rounded-xl text-xs font-bold flex items-center gap-1 transition cursor-pointer"
                  >
                    <Trash2 className="w-3.5 h-3.5" />
                    <span>حذف الصنف</span>
                  </button>
                ) : (
                  <div />
                )}

                <div className="flex items-center gap-2">
                  <button
                    type="button"
                    onClick={() => setIsModalOpen(false)}
                    className="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl text-xs font-bold transition cursor-pointer"
                  >
                    إلغاء
                  </button>
                  <button
                    type="submit"
                    className="px-5 py-2 bg-[#0F766E] hover:bg-teal-800 text-white rounded-xl text-xs font-black flex items-center gap-1.5 shadow-md transition cursor-pointer"
                  >
                    <Check className="w-4 h-4" />
                    <span>{editingProduct ? 'حفظ التعديلات' : 'إضافة الصنف'}</span>
                  </button>
                </div>
              </div>
            </form>
          </div>
        </div>
      )}
    </div>
  );
};
